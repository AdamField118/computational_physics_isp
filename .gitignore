# Keep source, notes, text-format numerical results, and reproducibility locks.
# Do not ignore whole results/ directories: their JSON/CSV/text data is useful.

# Python bytecode, packaging metadata, environments, and caches
__pycache__/
*.py[cod]
*.egg-info/
*.dist-info/
.venv/
venv/
env/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# Native builds, Rust outputs, and generated compiler files
target/
build/
dist/
.mesonpy-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.o
*.obj
*.mod
*.smod
*.so
*.so.*
*.dylib
*.dll
*.exe
*.a
*.lib
*.rlib
*.rmeta
*.pdb
*.dSYM/
helloworld

# Nix outputs and temporary lock files; retain dependency lockfiles
/result
/result-*
/outputs/
*.lock
!flake.lock
!**/Cargo.lock

